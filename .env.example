# Generation providers. Two companies: OpenAI for synthesis, Google for cheap planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Embeddings do not count as a second generation provider.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Real-time knowledge. Passed as a query parameter to the Tavily Remote MCP URL.
TAVILY_API_KEY=

# Local paths.
CHROMA_PERSIST_DIR=./chroma_index
SQLITE_PATH=./data/peps.sqlite
CODE_BUNDLE_DIR=./code_bundle

# Cloud Run.
GCP_PROJECT_ID=agenticaitwo
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=multi-agent-rag
