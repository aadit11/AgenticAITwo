# Do not inherit .gitignore. That file excludes chroma_index and peps.sqlite,
# and both have to be uploaded so the image can bake them in.
.git
.gcloudignore
.venv/
venv/
.env
.env.*
!.env.example
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
corpus/
eval/
scripts/
agent-transcripts/
.cursor/
